# ============================================================================
# CRS-FULL — Mapa de variaveis de ambiente
# ============================================================================
# Este arquivo NAO contem segredos. Ele apenas lista os NOMES das variaveis
# que o sistema espera. Pode ser commitado sem risco.
#
# Os valores REAIS ficam no painel do Render (Settings > Environment).
# O arquivo .env local nunca vai para o GitHub.
# ============================================================================

# ---------------------------------------------------------------------------
# BASE
# ---------------------------------------------------------------------------
# Porta do servidor. No Render, o valor e injetado automaticamente.
# Localmente, o padrao e 5000.
PORT=5000

# Nivel de log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO


# ---------------------------------------------------------------------------
# IDENTIDADE E ASSINATURA DE TOKEN  (SEM PADRAO — OBRIGATORIAS)
# ---------------------------------------------------------------------------
# Gere com:  python -c "import secrets; print(secrets.token_hex(32))"
# Minimo 32 caracteres. Se ausente ou curta, o servico NAO sobe.
SECRET_KEY=

# Chave separada para tokens de sessao, se o main.py usar uma distinta.
# Se o codigo nao ler esta variavel, deixe vazia e ela e ignorada.
JWT_SECRET_KEY=


# ---------------------------------------------------------------------------
# BANCO DE DADOS  (SEM PADRAO — OBRIGATORIA)
# ---------------------------------------------------------------------------
# Postgres do Render. Copie a "Internal Database URL" do painel.
# Aceita os prefixos postgres:// e postgresql:// — o codigo normaliza.
# SQLite NAO e aceito: o disco do Render e descartavel.
DATABASE_URL=


# ---------------------------------------------------------------------------
# CORS  (SEM PADRAO — OBRIGATORIA)
# ---------------------------------------------------------------------------
# Lista de origens autorizadas, separadas por virgula. Sem espacos.
# Curinga (*) nao e aceito.
# Exemplo: https://elayon.app,https://www.elayon.app
ALLOWED_ORIGINS=


# ---------------------------------------------------------------------------
# INGESTAO INTERNA CRS
# ---------------------------------------------------------------------------
# Token usado pela rota de ingestao de metricas, via header X-CRS-Token.
# Se estiver VAZIA, a rota continua aberta (comportamento atual).
# Quando definida, a rota passa a exigir o token. Gire a chave no Render
# somente DEPOIS de ajustar o cliente que chama essa rota.
TOKEN_INTERNO=


# ---------------------------------------------------------------------------
# LIMITES DE ENTRADA
# ---------------------------------------------------------------------------
# Tamanho maximo de upload de audio, em MB.
AUDIO_MAX_MB=25

# Duracao maxima de uma sessao de gravacao, em segundos.
SESSAO_MAX_S=300


# ---------------------------------------------------------------------------
# AMBIENTE
# ---------------------------------------------------------------------------
# desenvolvimento | producao
# Em producao o codigo recusa SQLite, CORS curinga e segredo curto.
AMBIENTE=desenvolvimento
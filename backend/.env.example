# ============================================================================
# ELAYON PLATFORM — ENVIRONMENT CONFIGURATION
# ============================================================================
# Este arquivo é um TEMPLATE. Copie pra .env, preencha com seus valores.
# NUNCA commite .env com valores reais. Sempre use variáveis de ambiente.
# ============================================================================

# DATABASE (Obrigatório)
DATABASE_URL=postgresql://user:password@host:port/database

# SUPABASE (Obrigatório)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=seu-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=seu-service-role-key-aqui

# AUTHENTICATION (Obrigatório)
SECRET_KEY=seu-segredo-32-caracteres-minimo
JWT_SECRET=seu-jwt-secret-32-caracteres-minimo

# CORS (Obrigatório)
ALLOWED_ORIGINS=http://localhost:3000,https://seu-dominio.com,https://paulorobertoxavierjunior-create.github.io

# SEGURANÇA INTERNA
X_CRS_TOKEN=seu-token-interno-para-chamar-health-check
X_INTERNAL_SECRET=seu-segredo-para-chamar-endpoints-internos

# ============================================================================
# PROVEDORES DE IA (GRATUITOS/ROTATIVOS)
# ============================================================================
# Deixe em branco se não tiver chave agora. Sistema vai pro fallback.
# Sempre colocar aqui, NUNCA no código.

# --- CONVERSAÇÃO (Chat, respostas calibradas)
OPENAI_API_KEY_PROD=
ANTHROPIC_API_KEY_PROD=
GEMINI_API_KEY_PROD=

# --- ANÁLISE (Processamento de áudio, extração de features)
DEEPGRAM_API_KEY_PROD=
ASSEMBLY_AI_KEY_PROD=
GOOGLE_SPEECH_TO_TEXT_KEY=

# --- SÍNTESE (Geração de texto em fala)
ELEVENLABS_API_KEY_PROD=
GOOGLE_TTS_API_KEY_PROD=

# --- VALIDAÇÃO (Checar consistência, detectar anomalias)
CUSTOM_VALIDATION_API_KEY=

# --- PLACEHOLDERS (Futuro)
IA_PLACEHOLDER_01_KEY=
IA_PLACEHOLDER_02_KEY=
IA_PLACEHOLDER_03_KEY=

# ============================================================================
# RENDER/DEPLOYMENT (Se rodar em produção)
# Deixe comentado se rodar local. Uncomment se subir no Render.
# ============================================================================
# PORT=5000
# ENVIRONMENT=production
# DEBUG=False